# Caddy: reverse proxy + HTTPS OTOMATIS (Let's Encrypt) untuk SIMAMA.
# {$APP_DOMAIN} dibaca dari environment (di-set docker-compose dari .env).
# Syarat auto-HTTPS: domain sudah mengarah ke IP server + port 80/443 terbuka.

{$APP_DOMAIN} {
    root * /var/www/html/public
    encode gzip zstd

    # File PHP diteruskan ke php-fpm (service "app" port 9000).
    php_fastcgi app:9000

    # Sajikan file statis (css/js/gambar/upload).
    file_server

    # Header keamanan.
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        -Server

        # Dulu no-referrer-when-downgrade, yang tetap mengirim URL LENGKAP ke
        # situs https lain. Sejak dokumen dilayani lewat URL bertanda tangan
        # (BerkasController), URL itu sendiri adalah kredensial sementara —
        # jangan sampai ikut bocor lewat header Referer.
        Referrer-Policy strict-origin-when-cross-origin

        # Paksa HTTPS untuk kunjungan berikutnya. Sengaja tanpa includeSubDomains
        # dan tanpa preload: keduanya yang sulit dibatalkan bila nanti ada
        # subdomain yang belum ber-TLS.
        Strict-Transport-Security "max-age=31536000"

        # Hanya arahan yang TIDAK menuntut penataan ulang kode. Halaman ini masih
        # memakai style & handler inline di banyak tempat, jadi default-src atau
        # script-src akan mematikan tampilan — itu pekerjaan terpisah.
        Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
    }

    # Batas ukuran unggahan (laporan/foto).
    request_body {
        max_size 15MB
    }
}
